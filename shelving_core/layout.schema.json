{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dbort/shelving-workbench/schemas/layout-v1.json",
  "title": "Shelving Carcass layout document",
  "description": "Serialised form of shelving_core.layout.Carcass (schema version 1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "carcass"],
  "properties": {
    "schema_version": { "const": 1 },
    "carcass": { "$ref": "#/$defs/carcass" }
  },
  "$defs": {
    "carcass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width_mm",
        "height_mm",
        "depth_mm",
        "default_material",
        "root"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "height_mm": { "type": "number", "exclusiveMinimum": 0 },
        "depth_mm": { "type": "number", "exclusiveMinimum": 0 },
        "default_material": { "type": "string", "minLength": 1 },
        "root": { "$ref": "#/$defs/bay" }
      }
    },
    "bay": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/leaf" },
        { "$ref": "#/$defs/split" }
      ]
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "leaf" },
        "id": { "type": "string" }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "orientation", "children", "rules", "dividers"],
      "properties": {
        "kind": { "const": "split" },
        "id": { "type": "string" },
        "orientation": { "enum": ["horizontal", "vertical"] },
        "children": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/bay" }
        },
        "rules": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/rule" }
        },
        "dividers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/divider" }
        }
      }
    },
    "rule": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/fixedRule" },
        { "$ref": "#/$defs/weightedRule" },
        { "$ref": "#/$defs/fillRule" }
      ]
    },
    "fixedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size_mm"],
      "properties": {
        "type": { "const": "fixed" },
        "size_mm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "weightedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "weight"],
      "properties": {
        "type": { "const": "weighted" },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "fillRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "fill" }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "material": { "type": ["string", "null"] },
        "lap": { "enum": ["captured", "through", null] }
      }
    }
  }
}
